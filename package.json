{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "build:dev": "vite build --mode development",
        "dev": "vite",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:ui": "vitest --ui",
        "test:coverage": "vitest run --coverage",
        "test:php": "php artisan test",
        "test:all": "npm run test && npm run test:php"
    },
    "dependencies": {
        "@radix-ui/react-context-menu": "^2.3.8",
