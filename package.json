        "@tanstack/react-router": "^1.0.0",
        "@tanstack/router-plugin": "^1.168.42",
        "axios": "^1.20.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "lucide-react": "^1.52.0",
        "react": "^18.2.0",
        "react-day-picker": "^10.0.2",
        "react-dom": "^18.2.0",
        "tailwind-merge": "^3.7.0",
        "tw-animate-css": "^1.4.0"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.0.0",
