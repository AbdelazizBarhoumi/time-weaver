APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT="${APP_URL}/api/calendar/google/callback"

# Google Gemini — powers the "Coach my day" button on the calendar.
# Uses the Interactions API (https://ai.google.dev/gemini-api/docs/interactions-overview).
# Only the API key is required; the knobs below are optional and fall back to
# sensible defaults when omitted. Note: the Interactions API has no `top_k`.
GEMINI_API_KEY=
# Model picks (Interactions API). For a latency-sensitive coach:
#   gemini-3.5-flash-lite  fastest, best starting point (default)
#   gemini-3.1-flash-lite  lightweight alternative
#   gemini-3.8-flash       stronger reasoning, noticeably slower
#   gemini-3.1-pro-preview deepest reasoning, avoid for this use case
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_API_REVISION=2026-05-20
GEMINI_TEMPERATURE=0.6
GEMINI_TOP_P=0.95
# Must leave room for the model's thinking, which counts against this cap;
# too low and replies come back truncated (status: incomplete).
GEMINI_MAX_OUTPUT_TOKENS=4096
GEMINI_THINKING_LEVEL=low
GEMINI_SEED=
GEMINI_STORE=false
# Thinking models can be slow (60s+ during demand spikes), so be generous.
GEMINI_TIMEOUT=60
GEMINI_CONNECT_TIMEOUT=10
GEMINI_RETRIES=2

VITE_APP_NAME="${APP_NAME}"
